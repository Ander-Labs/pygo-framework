# Environment Variables for PyGo Application
# Copy this file to .env and update values for production

# Database Configuration
DB_DRIVER=sqlite
DB_PATH=./data/app.db
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=myapp
# DB_USER=postgres
# DB_PASSWORD=your_password_here

# Security Secrets (CHANGE THESE IN PRODUCTION!)
JWT_SECRET=your_jwt_secret_change_me
APP_KEY=your_app_key_change_me
SESSION_SECRET=your_session_secret_change_me

# Server Configuration
HOST=0.0.0.0
PORT=8080
DEBUG=true

# Email Configuration (optional)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_email@example.com
# SMTP_PASSWORD=your_smtp_password

# Redis Configuration (optional)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Logging
LOG_LEVEL=info